# Chave gratuita em https://console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Banco de dados (deixe vazio para usar apenas --demo)
DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/estoque

# Ajustes do relatório
DIAS_COBERTURA=14
MAX_ITENS=10
OUTPUT_DIR=reports
